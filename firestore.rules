rules_version = '2';

// データ構造
//   users/{uid}                         プロフィール（role / name / avatar / atelierId / lastSeenAt / handle）
//   handles/{handle}                    @ユーザーネーム → 使っている人の uid（同じユーザーネームを2人が使えないようにする）
//   atelierKeys/{key}                   12桁の鍵番号 → アーティストuid
//   ateliers/{artistUid}                アトリエ（mood / isOpen / online / lastActiveAt。旧データには status が残っている場合あり）
//     items/{itemId}                    TODO / 悩み
//     posts/{postId}                    ホームのタイムライン（アーティストのひとこと・ファンの投稿。メンバー全員が閲覧可）
//                                       画像・解読モード（decode.goal）はアーティストのみ。expiresAt（7日後）を過ぎるとタイムラインに出ない
//                                       音楽URL（music。Spotify / Apple Music）は全員が付けられる
//     comments/{uid_日付_回数}          アーティストの投稿へのコメント（アーティストへの手紙。アーティストと書いた本人だけが閲覧可）
//     commentQuota/{fanUid}             ファンがその日に送ったコメントの回数（1日3回まで）
//     members/{fanUid}                  参加中のファン（応援回数つき）
//     notices/{id}                      ファン → アーティストへの通知（ギフト・応援・参加）
//     updates/{id}                      アーティスト → ファンへの通知（ステータス・ひとこと・タスク）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function memberPath(atelierId, uid) {
      return /databases/$(database)/documents/ateliers/$(atelierId)/members/$(uid);
    }

    function isArtistOf(atelierId) {
      return isSelf(atelierId) && get(userPath(atelierId)).data.role == 'artist';
    }

    function isMemberOf(atelierId) {
      return signedIn() && exists(memberPath(atelierId, request.auth.uid));
    }

    function canView(atelierId) {
      return isArtistOf(atelierId) || isMemberOf(atelierId);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 20;
    }

    function validAvatar(avatar) {
      return avatar is map
        && ((avatar.type == 'preset' && avatar.preset is string)
          || (avatar.type == 'image' && avatar.src is string && avatar.src.size() < 400000));
    }

    function shortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isNow(value) {
      return value == request.time;
    }

    // 投稿の有効期限：作成から7日後（端末の時計のずれを考えて 6〜8日後 なら受け付ける）
    function validExpiry(value) {
      return value is timestamp
        && value > request.time + duration.value(6, 'd')
        && value < request.time + duration.value(8, 'd');
    }

    // 投稿に付けられる絵文字（src/constants.js の REACTIONS と同じにすること）
    function validReactions(list) {
      return list is list && list.size() > 0 && list.size() <= 4
        && list.hasOnly(['❤️', '🔥', '👏', '👍']);
    }

    // 投稿に付けられる音楽URL（Spotify / Apple Music のみ。src/constants.js の MUSIC_URL_MAX と合わせる）
    function validMusic(url) {
      return url is string && url.size() <= 300
        && url.matches('^https://(open[.]spotify[.]com|music[.]apple[.]com)/[^ ]+$');
    }

    // 日本時間の今日を 20261026 のような数字にする（src/utils/time.js の todayJst と同じ計算）
    function todayJst() {
      let t = request.time + duration.value(9, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // @ユーザーネーム：半角英小文字・数字・_ の3〜15文字。未設定（null）でもよい（src/constants.js の HANDLE_PATTERN と合わせる）
    function validHandle(handle) {
      return handle == null || (handle is string && handle.matches('^[a-z0-9_]{3,15}$'));
    }

    function handlePath(handle) {
      return /databases/$(database)/documents/handles/$(handle);
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['role', 'name', 'avatar', 'atelierId', 'lastSeenAt', 'createdAt'])
        && request.resource.data.role in ['artist', 'fan']
        && validName(request.resource.data.name)
        && validAvatar(request.resource.data.avatar)
        && request.resource.data.atelierId == null;

      // ロールは変更不可。参加アトリエは、実際にメンバーになっている場合のみ設定できる
      // @ユーザーネームを変えるときは、同時に台帳（handles）でその名前を自分のものにしていること
      allow update: if isSelf(uid)
        && onlyChanges(['name', 'avatar', 'atelierId', 'lastSeenAt', 'handle'])
        && validName(request.resource.data.name)
        && validAvatar(request.resource.data.avatar)
        && validHandle(request.resource.data.get('handle', null))
        && (request.resource.data.get('handle', null) == resource.data.get('handle', null)
          || request.resource.data.handle == null
          || getAfter(handlePath(request.resource.data.handle)).data.uid == uid)
        && (request.resource.data.atelierId == null
          || request.resource.data.atelierId == resource.data.atelierId
          || existsAfter(memberPath(request.resource.data.atelierId, uid)));
    }

    // @ユーザーネームの台帳：自分のプロフィールに設定する名前だけを取れる。手放すのも自分の分だけ
    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.get('handle', null) == handle;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.get('handle', null) != handle;
    }

    match /atelierKeys/{key} {
      // 鍵番号を知っている人だけが1件ずつ引ける（一覧は自分の鍵のみ）
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.artistUid == request.auth.uid;
      allow create: if signedIn()
        && key.matches('^[0-9]{12}$')
        && request.resource.data.keys().hasOnly(['artistUid', 'createdAt'])
        && request.resource.data.artistUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'artist'
        && isNow(request.resource.data.createdAt);
      allow delete: if signedIn() && resource.data.artistUid == request.auth.uid;
    }

    match /ateliers/{atelierId} {
      allow read: if canView(atelierId);
      allow create: if isSelf(atelierId)
        && getAfter(userPath(atelierId)).data.role == 'artist'
        && request.resource.data.keys().hasOnly(['mood', 'isOpen', 'online', 'lastActiveAt'])
        && request.resource.data.mood is string
        && request.resource.data.isOpen is bool
        && request.resource.data.online is bool
        && isNow(request.resource.data.lastActiveAt);
      // オンライン表示（online / lastActiveAt）は本人のブラウザが自動で更新する
      allow update: if isArtistOf(atelierId)
        && onlyChanges(['mood', 'isOpen', 'online', 'lastActiveAt'])
        && request.resource.data.mood is string
        && request.resource.data.mood.size() <= 140
        && request.resource.data.get('isOpen', false) is bool
        && request.resource.data.get('online', false) is bool
        && (!('lastActiveAt' in request.resource.data.diff(resource.data).affectedKeys())
          || isNow(request.resource.data.lastActiveAt));

      match /items/{itemId} {
        allow read: if canView(atelierId);
        allow create: if isArtistOf(atelierId)
          && request.resource.data.keys().hasOnly(['tag', 'text', 'giftCount', 'done', 'createdAt'])
          && request.resource.data.tag in ['TODO', '悩み']
          && shortText(request.resource.data.text, 100)
          && request.resource.data.giftCount == 0
          && request.resource.data.done == false
          && isNow(request.resource.data.createdAt);
        allow delete: if isArtistOf(atelierId);
        // アーティストは完了状態のみ、ファンはギフト数を1ずつ増やすことのみ可能
        allow update: if (isArtistOf(atelierId)
            && onlyChanges(['done'])
            && request.resource.data.done is bool)
          || (isMemberOf(atelierId)
            && onlyChanges(['giftCount'])
            && request.resource.data.giftCount == resource.data.giftCount + 1);
      }

      match /members/{memberId} {
        allow read: if canView(atelierId);
        // 正しい鍵番号を知っているファンだけが参加できる
        allow create: if isSelf(memberId)
          && get(userPath(memberId)).data.role == 'fan'
          && request.resource.data.keys().hasOnly(['key', 'name', 'avatar', 'handle', 'giftCount', 'joinedAt'])
          && get(/databases/$(database)/documents/atelierKeys/$(request.resource.data.key)).data.artistUid == atelierId
          && validName(request.resource.data.name)
          && validAvatar(request.resource.data.avatar)
          && request.resource.data.get('handle', null) == getAfter(userPath(memberId)).data.get('handle', null)
          && request.resource.data.giftCount == 0
          && isNow(request.resource.data.joinedAt);
        allow update: if isSelf(memberId)
          && onlyChanges(['name', 'avatar', 'handle', 'giftCount'])
          && validName(request.resource.data.name)
          && validAvatar(request.resource.data.avatar)
          && (!('handle' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.handle == getAfter(userPath(memberId)).data.get('handle', null))
          && (request.resource.data.giftCount == resource.data.giftCount
            || request.resource.data.giftCount == resource.data.giftCount + 1);
        allow delete: if isSelf(memberId) || isArtistOf(atelierId);
      }

      match /posts/{postId} {
        allow read: if canView(atelierId);
        // 名前とロールは本人のプロフィールと一致させる（なりすまし防止）
        // 本文は140文字まで（画像か音楽付きなら空でもよい）。画像・解読モード・アーカイブ指定はアーティストのみ
        allow create: if canView(atelierId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'text', 'reactions', 'createdAt', 'expiresAt', 'isArchive', 'image', 'decode', 'music'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == get(userPath(request.auth.uid)).data.name
          && request.resource.data.role == get(userPath(request.auth.uid)).data.role
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 140
          && (request.resource.data.text.size() > 0 || 'image' in request.resource.data || 'music' in request.resource.data)
          && (!('music' in request.resource.data) || validMusic(request.resource.data.music))
          && request.resource.data.get('reactions', {}) == {}
          && isNow(request.resource.data.createdAt)
          && validExpiry(request.resource.data.expiresAt)
          && request.resource.data.isArchive is bool
          && (request.resource.data.isArchive == false || request.resource.data.role == 'artist')
          && (!('image' in request.resource.data)
            || (request.resource.data.role == 'artist'
              && request.resource.data.image is string
              && request.resource.data.image.size() < 800000))
          && (!('decode' in request.resource.data)
            || ('image' in request.resource.data
              && request.resource.data.decode is map
              && request.resource.data.decode.keys().hasOnly(['goal'])
              && request.resource.data.decode.goal is int
              && request.resource.data.decode.goal >= 1
              && request.resource.data.decode.goal <= 1000));
        // リアクション：メンバーは自分の分（reactions.自分のuid）だけ付け外しできる
        allow update: if canView(atelierId)
          && onlyChanges(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
            || validReactions(request.resource.data.reactions[request.auth.uid]));
      }

      // コメント（アーティストへの手紙）：ファンだけが、アーティストの投稿に送れる
      //   ドキュメントIDは「uid_日付_その日の何回目」。回数（commentQuota）を1増やすのと同時に書き込み、
      //   IDの回数と commentQuota の回数が一致することを確かめるので、1日3回を超えて送ることはできない
      //   読めるのはアーティストと、書いた本人だけ（ファン同士では見えない）
      match /comments/{commentId} {
        allow read: if isArtistOf(atelierId)
          || (isMemberOf(atelierId) && resource.data.uid == request.auth.uid);
        allow create: if isMemberOf(atelierId)
          && get(userPath(request.auth.uid)).data.role == 'fan'
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'postId', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == get(userPath(request.auth.uid)).data.name
          && request.resource.data.role == 'fan'
          && request.resource.data.postId is string
          && get(/databases/$(database)/documents/ateliers/$(atelierId)/posts/$(request.resource.data.postId)).data.role == 'artist'
          && shortText(request.resource.data.text, 140)
          && isNow(request.resource.data.createdAt)
          && getAfter(/databases/$(database)/documents/ateliers/$(atelierId)/commentQuota/$(request.auth.uid)).data.day == todayJst()
          && commentId == request.auth.uid + '_' + string(todayJst()) + '_'
            + string(getAfter(/databases/$(database)/documents/ateliers/$(atelierId)/commentQuota/$(request.auth.uid)).data.count);
      }

      // その日のコメント回数：本人だけが、1ずつ増やせる（日付が変わったら 1 から数え直す）。最大3回
      match /commentQuota/{fanUid} {
        allow read: if isSelf(fanUid);
        allow create: if isSelf(fanUid) && isMemberOf(atelierId)
          && request.resource.data.keys().hasOnly(['day', 'count'])
          && request.resource.data.day == todayJst()
          && request.resource.data.count == 1;
        allow update: if isSelf(fanUid) && isMemberOf(atelierId)
          && request.resource.data.keys().hasOnly(['day', 'count'])
          && request.resource.data.day == todayJst()
          && request.resource.data.count <= 3
          && ((resource.data.day == todayJst() && request.resource.data.count == resource.data.count + 1)
            || (resource.data.day != todayJst() && request.resource.data.count == 1));
      }

      match /notices/{noticeId} {
        allow read, delete: if isArtistOf(atelierId);
        allow create: if signedIn()
          && existsAfter(memberPath(atelierId, request.auth.uid))
          && request.resource.data.keys().hasOnly(['kind', 'fromUid', 'fromName', 'itemText', 'message', 'createdAt'])
          && request.resource.data.kind in ['gift', 'post', 'join']
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromName == get(userPath(request.auth.uid)).data.name
          && (!('itemText' in request.resource.data) || shortText(request.resource.data.itemText, 100))
          && (!('message' in request.resource.data) || shortText(request.resource.data.message, 140))
          && isNow(request.resource.data.createdAt);
      }

      match /updates/{updateId} {
        allow read: if canView(atelierId);
        allow delete: if isArtistOf(atelierId);
        allow create: if isArtistOf(atelierId)
          && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt'])
          && request.resource.data.kind in ['status', 'mood', 'item', 'done']
          && shortText(request.resource.data.text, 200)
          && isNow(request.resource.data.createdAt);
      }
    }
  }
}
